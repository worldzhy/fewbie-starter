# Heartbeat monitoring (optional).
# Uncomment and fill in to enroll this application into heartbeat
# monitoring; leave them out to run standalone.
# HEARTBEAT_ENDPOINT=https://<heartbeat-host>/heartbeat/ping
# HEARTBEAT_TOKEN=<installation token>

# Web monitor (optional, browser side).
# The WebMonitor component (src/components/web-monitor.tsx) dynamically loads
# @devbie/web-monitor-sdk in the browser and is a no-op until all three vars
# are set. NEXT_PUBLIC_ values are inlined at build time, so set them before
# `next build` — not only at runtime.
# NEXT_PUBLIC_WEB_MONITOR_ENDPOINT=https://<web-monitor-host>/web-monitor/report
# NEXT_PUBLIC_WEB_MONITOR_APP_ID=<application id>
# NEXT_PUBLIC_WEB_MONITOR_TOKEN=<report token>

# Base URL for API clients generated by `fewbie apits`.
# Browser code can only read variables prefixed with NEXT_PUBLIC_.
# NEXT_PUBLIC_BASE_URL=http://localhost:3000/api
