# fewbie:framework:start
# Heartbeat monitoring (optional), read by src/instrumentation.ts.
# Uncomment and fill in to enroll this application into heartbeat monitoring;
# leave them out to run standalone.
# HEARTBEAT_ENDPOINT=https://<heartbeat-host>/heartbeat/ping
# HEARTBEAT_TOKEN=<installation token>
# fewbie:framework:end

# Base URL for API clients generated by `fewbie apits`.
# Browser code can only read variables prefixed with NEXT_PUBLIC_.
# NEXT_PUBLIC_BASE_URL=http://localhost:3000/api

# Web monitor (optional, browser side).
# The FrontendMonitor component (src/components/frontend-monitor.tsx) dynamically loads
# @devbie/frontend-monitor-sdk in the browser and is a no-op until both vars are
# set. NEXT_PUBLIC_ values are inlined at build time, so set them before
# `next build` — not only at runtime.
# NEXT_PUBLIC_FRONTEND_MONITOR_ENDPOINT=https://<frontend-monitor-host>/frontend-monitor/report
# NEXT_PUBLIC_FRONTEND_MONITOR_TOKEN=<report token>
