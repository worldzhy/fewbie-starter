{
  "name": "fewbie-basic-template",
  "version": "1.1.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "prettier": "@devbie/style-guide/prettier",
  "scripts": {
    "build": "next build",
    "check:framework-adr": "node scripts/check-framework-adr.mjs",
    "check:layout-shell": "node scripts/check-layout-shell.mjs",
    "check:page-contract": "node scripts/check-page-contract.mjs",
    "check:primitives": "node scripts/check-primitives.mjs",
    "check:routes": "node scripts/check-route-conventions.mjs",
    "check:structure": "npm run check:page-contract && npm run check:layout-shell && npm run check:primitives && npm run check:routes",
    "check:template": "FEWBIE_TEMPLATE_REGISTRY_COMPLETE=1 fewbie template update --check --template-path .",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "prepare": "command -v git >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "start": "next start",
    "test": "node --experimental-test-module-mocks --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"scripts/**/*.test.mjs\""
  },
  "dependencies": {
    "@devbie/heartbeat-sdk": "^1.2.1",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "dayjs": "^1.11.18",
    "echarts": "^6.0.0",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@devbie/fewbie-cli": "^1.15.2",
    "@devbie/style-guide": "^1.8.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "jsdom": "^28.1.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^6"
  }
}
